# =========================================================================
# Mapa de Automação Bluemetrics — variáveis de ambiente (exemplo)
# Copie para .env.local e preencha. NUNCA versione segredos reais.
# =========================================================================

# --- Apollo (Organization Enrichment) -----------------------------------
# Sem chave em desenvolvimento, o adaptador simulado é usado automaticamente.
# Em produção sem chave, a jornada segue por preenchimento manual.
APOLLO_API_KEY=
APOLLO_ENRICHMENT_ENABLED=true
APOLLO_DAILY_LOOKUP_LIMIT=500
APOLLO_LOOKUPS_PER_SESSION=3
APOLLO_TIMEOUT_MS=5000

# Força o adaptador simulado mesmo com chave presente (útil em preview).
# Dados simulados nunca são apresentados como dados reais de uma empresa.
COMPANY_ENRICHMENT_USE_MOCK=false

# --- Cache de enriquecimento --------------------------------------------
COMPANY_CACHE_TTL_HOURS=168
COMPANY_NEGATIVE_CACHE_TTL_MINUTES=60

# --- Supabase (persistência de produção) --------------------------------
# No MVP local a persistência do diagnóstico é feita no navegador.
# Estas variáveis preparam a troca para o Supabase sem mudar o domínio.
SUPABASE_URL=
SUPABASE_SERVER_SECRET=

# --- Aplicação ----------------------------------------------------------
APP_BASE_URL=http://localhost:3000
BOOKING_URL=
ENABLE_LLM_ASSIST=false
